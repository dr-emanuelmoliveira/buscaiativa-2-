# ============================================================
# --- 3. DETECCAO AUTOMATICA DO INDICADOR ---
# ============================================================

def _preparar_padroes(config):
    return {
        "decisivos": [_normalizar_texto(p) for p in config.get("padroes_decisivos", [])],
        "regulares": [_normalizar_texto(p) for p in config.get("colunas_detectar", [])],
        "excluir": [_normalizar_texto(p) for p in config.get("colunas_excluir", [])],
    }


_PADROES_NORMALIZADOS = {
    codigo: _preparar_padroes(config) for codigo, config in INDICADORES.items()
}


def detectar_indicador(colunas_csv, verbose=True):
    """Identifica o indicador (C2..C7) a partir das colunas do CSV."""
    colunas_norm = [_normalizar_texto(c) for c in colunas_csv]
    scores = {}
    detalhes = {}

    for codigo, padroes in _PADROES_NORMALIZADOS.items():
        decisivos = sum(
            10 for p in padroes["decisivos"]
            if p and any(p in col for col in colunas_norm)
        )
        regulares = sum(
            1 for p in padroes["regulares"]
            if p and any(p in col for col in colunas_norm)
        )
        penalidades = sum(
            -5 for p in padroes["excluir"]
            if p and any(p in col for col in colunas_norm)
        )
        scores[codigo] = decisivos + regulares + penalidades
        detalhes[codigo] = {
            "decisivos": decisivos,
            "regulares": regulares,
            "penalidades": penalidades,
            "total": scores[codigo],
        }

    melhor = max(scores, key=scores.get)

    if verbose:
        print("=" * 70)
        print("  DETECCAO AUTOMATICA DE INDICADOR")
        print(f"  Colunas no CSV: {len(colunas_csv)}")
        print("=" * 70)
        print(f"  {'Indicador':<40} {'Decis.':>6} {'Regul.':>6} {'Penal.':>6} {'TOTAL':>6}")
        print("  " + "-" * 68)
        for codigo in sorted(scores):
            d = detalhes[codigo]
            marca = " <<< SELECIONADO" if codigo == melhor else ""
            print(
                f"  {codigo} - {INDICADORES[codigo]['nome']:<34} "
                f"{d['decisivos']:>5}  {d['regulares']:>5}  "
                f"{d['penalidades']:>5}  {d['total']:>5}{marca}"
            )

    if scores[melhor] <= 0:
        if verbose:
            print("\n  AVISO: Nenhum indicador teve score positivo!")
            print("  Colunas do CSV (normalizadas):")
            for c in colunas_norm:
                print(f"    - {c}")
        raise ValueError(
            "Nao foi possivel detectar o indicador. "
            "Verifique se o CSV contem as colunas esperadas."
        )

    if verbose:
        print(f"\n  INDICADOR DETECTADO: {melhor} - {INDICADORES[melhor]['nome']}")
        print("=" * 70 + "\n")
    return melhor


# ============================================================
# --- 4. CARREGAMENTO DO CSV ---
# ============================================================

_ENCODINGS = ("utf-8-sig", "utf-8", "cp1252", "iso-8859-1", "latin-1")


def ler_conteudo_csv(caminho_ou_buffer):
    """Le bytes e identifica o encoding. Retorna (texto, encoding, bytes)."""
    if hasattr(caminho_ou_buffer, "read"):
        try:
            caminho_ou_buffer.seek(0)
        except (OSError, ValueError):
            pass
        conteudo = caminho_ou_buffer.read()
        if isinstance(conteudo, str):
            conteudo = conteudo.encode("latin-1", errors="ignore")
        try:
            caminho_ou_buffer.seek(0)
        except (OSError, ValueError):
            pass
    else:
        with open(caminho_ou_buffer, "rb") as arquivo:
            conteudo = arquivo.read()

    if not conteudo:
        raise ValueError("O arquivo CSV esta vazio.")

    for encoding in _ENCODINGS:
        try:
            return conteudo.decode(encoding), encoding, conteudo
        except UnicodeDecodeError:
            continue
    raise ValueError("Nao foi possivel identificar o encoding do arquivo CSV.")


def separar_linha_csv(linha, delimitador):
    """Divide uma linha respeitando campos entre aspas."""
    try:
        return next(csv.reader(
            [linha],
            delimiter=delimitador,
            quotechar='"',
            doublequote=True,
            skipinitialspace=True,
        ))
    except (csv.Error, StopIteration):
        return []


def detectar_skiprows(caminho_ou_buffer, verbose=True):
    """Identifica quantas linhas devem ser ignoradas antes do cabecalho."""
    texto, encoding, _ = ler_conteudo_csv(caminho_ou_buffer)
    linhas = texto.splitlines()
    if not linhas:
        return 0

    for numero_linha, linha in enumerate(linhas[:100]):
        if not linha.strip():
            continue
        for delimitador in (";", ",", "\t"):
            campos = [c.strip() for c in separar_linha_csv(linha, delimitador)]
            if len(campos) < 3 or sum(bool(c) for c in campos) < 3:
                continue

            compativeis = 0
            indice = numero_linha + 1
            while indice < len(linhas) and compativeis < 5:
                proxima = linhas[indice]
                if not proxima.strip():
                    indice += 1
                    continue
                if len(separar_linha_csv(proxima, delimitador)) == len(campos):
                    compativeis += 1
                    indice += 1
                else:
                    break

            if compativeis >= 2:
                if verbose:
                    print("Estrutura detectada:")
                    print(f"   Encoding: {encoding}")
                    print(f"   Skiprows: {numero_linha}")
                    print(f"   Delimitador provavel: {delimitador!r}")
                    print(f"   Numero de colunas: {len(campos)}")
                return numero_linha

    for numero_linha, linha in enumerate(linhas[:100]):
        if len(separar_linha_csv(linha, ";")) >= 3:
            return numero_linha
    return 0


def detectar_delimitador(caminho_ou_buffer, skiprows):
    """Detecta se o CSV usa ';', ',' ou tabulacao."""
    texto, _, _ = ler_conteudo_csv(caminho_ou_buffer)
    linhas = texto.splitlines()
    if not linhas or skiprows >= len(linhas):
        return ";"

    cabecalho = linhas[skiprows]
    contagem = {
        d: len(separar_linha_csv(cabecalho, d)) for d in (";", ",", "\t")
    }
    escolhido = max(contagem, key=contagem.get)
    return escolhido if contagem[escolhido] >= 2 else ";"


def validar_dataframe(df):
    """Limpeza inicial segura do DataFrame."""
    if df is None:
        raise ValueError("O DataFrame nao foi carregado.")
    if df.empty:
        raise ValueError("O CSV foi lido, mas nao possui registros.")

    df = df.dropna(axis=1, how="all").copy()
    df.columns = [str(c).strip() for c in df.columns]

    for coluna in df.columns:
        if df[coluna].dtype == "object":
            df[coluna] = df[coluna].map(
                lambda v: v.strip() if isinstance(v, str) else v
            )
    return df


def carregar_csv(caminho=None):
    """Carrega o CSV do e-SUS APS."""
    if caminho is None:
        caminho = os.environ.get("CSV_PATH") or input(
            "Caminho do arquivo .csv do e-SUS APS: "
        ).strip()

    if not str(caminho).lower().endswith(".csv"):
        raise ValueError("O arquivo informado nao possui extensao .csv.")

    nome_arquivo = Path(caminho).name
    texto, encoding, _ = ler_conteudo_csv(caminho)
    skiprows = detectar_skiprows(caminho)
    delimitador = detectar_delimitador(caminho, skiprows)

    try:
        df = pd.read_csv(
            io.StringIO(texto),
            sep=delimitador,
            skiprows=skiprows,
            header=0,
            quotechar='"',
            doublequote=True,
            dtype=str,
            engine="python",
            on_bad_lines="warn",
            keep_default_na=False,
            na_filter=False,
        )
    except Exception as erro:
        raise ValueError(
            "\nNao foi possivel carregar o CSV.\n"
            f"Arquivo: {nome_arquivo}\n"
            f"Encoding: {encoding}\n"
            f"Delimitador: {delimitador!r}\n"
            f"Skiprows: {skiprows}\n"
            f"Erro: {erro}"
        ) from erro

    df = validar_dataframe(df)

    print("\nArquivo carregado com sucesso:")
    print(f"   Arquivo: {nome_arquivo}")
    print(f"   Encoding: {encoding}")
    print(f"   Delimitador: {delimitador!r}")
    print(f"   Skiprows: {skiprows}")
    print(f"   Linhas: {len(df)}")
    print(f"   Colunas: {len(df.columns)}")
    print("\nColunas identificadas:")
    for numero, coluna in enumerate(df.columns, start=1):
        print(f"   {numero}. {coluna}")
    print("\nPrimeiras linhas:")
    print(df.head().to_string())

    return df, nome_arquivo


# ============================================================
# --- 5. PREPARACAO DOS DADOS ---
# ============================================================

def _calcular_idade_data_nasc(data_nasc):
    """Calcula idade em anos a partir da data de nascimento."""
    data = _parse_data(data_nasc)
    if data is None or pd.isna(data):
        return 0.0
    hoje = datetime.now()
    idade = hoje.year - data.year
    if (hoje.month, hoje.day) < (data.month, data.day):
        idade -= 1
    return float(idade) if 0 <= idade <= 130 else 0.0


