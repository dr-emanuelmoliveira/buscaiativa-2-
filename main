    "pneumo": ["pneumo", "pneumococica", "vpc10"],
    "penta": ["penta", "pentavalente", "dtp", "hib"],
    "polio": ["polio", "poliomielite", "vip"],
}


def encontrar_coluna(df, candidatos):
    """Encontra coluna no DataFrame com normalizacao de acentos."""
    colunas_norm = {_normalizar_texto(str(c)): c for c in df.columns}
    candidatos_norm = [_normalizar_texto(c) for c in candidatos]

    for cand in candidatos_norm:
        if cand in colunas_norm:
            return colunas_norm[cand]

    for cand in candidatos_norm:
        if not cand:
            continue
        for col_norm, col_orig in colunas_norm.items():
            if cand in col_norm:
                return col_orig

    for cand in candidatos_norm:
        for variacoes in _PALAVRAS_CHAVE.values():
            for var in variacoes:
                var_norm = _normalizar_texto(var)
                if var_norm and var_norm in cand:
                    for col_norm, col_orig in colunas_norm.items():
                        if var_norm in col_norm:
                            return col_orig
    return None


def preparar_dados(df, codigo_indicador):
    """Prepara os dados conforme o indicador detectado."""
    config = INDICADORES[codigo_indicador]
    colunas_mapeadas = {}

    print("\n   Mapeamento de colunas:")
    print("   " + "-" * 50)
    for chave, candidatos in config["colunas_csv"].items():
        coluna = encontrar_coluna(df, candidatos)
        if coluna is not None:
            colunas_mapeadas[chave] = coluna
            print(f"   [OK] {chave:<25} -> '{coluna}'")
        else:
            print(f"   [--] {chave:<25} -> NAO ENCONTRADA")

    nome_col = colunas_mapeadas.get("nome", df.columns[0])
    microarea_col = colunas_mapeadas.get(
        "microarea", df.columns[1] if len(df.columns) > 1 else df.columns[0]
    )

    dados = pd.DataFrame(index=df.index)
    dados["Nome"] = df[nome_col].astype(str).str.strip()
    dados["Microarea"] = df[microarea_col].astype(str).str.strip()

    data_nasc_col = colunas_mapeadas.get("data_nascimento")

    if codigo_indicador == "C2":
        idade_col = colunas_mapeadas.get("idade_meses")
        if data_nasc_col:
            dados["Idade"] = df[data_nasc_col].map(_calcular_idade_data_nasc)
            dados["Idade_meses"] = (dados["Idade"] * 12).round(0).astype(int)
            print("   Idade calculada a partir da data de nascimento")
        elif idade_col:
            dados["Idade_meses"] = df[idade_col].map(_extrair_meses)
            dados["Idade"] = (dados["Idade_meses"] / 12).round(1)
            print("   Idade extraida da coluna meses")
        else:
            dados["Idade_meses"] = 0
            dados["Idade"] = 0
            print("   AVISO: Idade nao encontrada - usando 0")
    else:
        idade_col = colunas_mapeadas.get("idade")
        if data_nasc_col:
            dados["Idade"] = df[data_nasc_col].map(_calcular_idade_data_nasc)
            print("   Idade calculada a partir da data de nascimento")
        elif idade_col:
            dados["Idade"] = df[idade_col].map(_parse_idade)
            print("   Idade extraida da coluna de idade")
        else:
            dados["Idade"] = 0
            print("   AVISO: Idade nao encontrada - usando 0")

    if data_nasc_col:
        dados["Data_Nascimento"] = df[data_nasc_col]

    ignorar = {"nome", "microarea", "idade", "idade_meses", "data_nascimento"}
    for chave, col_orig in colunas_mapeadas.items():
        if chave not in ignorar:
            dados[chave] = df[col_orig]

    print(f"\n   Colunas mapeadas: {len(colunas_mapeadas)}")
    print(f"   Amostra de idades: {dados['Idade'].head(10).tolist()}")
    return dados, colunas_mapeadas


