def gerar_grafico_pizza(df_resultado, codigo_indicador):
    if not _HAS_MPL:
        print("AVISO: matplotlib nao instalado - graficos ignorados.")
        return None
    contagem = df_resultado["Microarea"].value_counts()
    fig, ax = plt.subplots(figsize=(10, 7))
    ax.pie(
        contagem.values,
        labels=contagem.index,
        autopct="%1.1f%%",
        colors=plt.cm.Set3(np.linspace(0, 1, len(contagem))),
        startangle=90,
    )
    ax.set_title(
        f"Distribuicao de Pacientes por Microarea\n"
        f"Indicador {codigo_indicador} - {INDICADORES[codigo_indicador]['nome']}",
        fontsize=14, fontweight="bold",
    )
    ax.axis("equal")
    fig.tight_layout()
    nome_arq = f"grafico_pizza_microarea_{codigo_indicador}.png"
    fig.savefig(nome_arq, dpi=150, bbox_inches="tight")
    plt.close(fig)
    print(f"Grafico salvo: {nome_arq}")
    return nome_arq


def gerar_grafico_barras(df_resultado, codigo_indicador):
    if not _HAS_MPL:
        print("AVISO: matplotlib nao instalado - graficos ignorados.")
        return None
    ordem = ["EM DIA", "MODERADO", "GRAVE", "MUITO GRAVE", "CRITICO"]
    contagem = df_resultado["Nivel"].value_counts().reindex(ordem, fill_value=0)
    cores = ["#2ecc71", "#f1c40f", "#e67e22", "#e74c3c", "#c0392b"]

    fig, ax = plt.subplots(figsize=(12, 6))
    barras = ax.bar(contagem.index, contagem.values, color=cores, edgecolor="black")
    ax.set_title(
        f"Classificacao de Risco - Indicador {codigo_indicador}\n"
        f"{INDICADORES[codigo_indicador]['nome']}",
        fontsize=14, fontweight="bold",
    )
    ax.set_xlabel("Nivel de Prioridade", fontsize=12)
    ax.set_ylabel("Numero de Pacientes", fontsize=12)
    for barra, valor in zip(barras, contagem.values):
        if valor > 0:
            ax.text(
                barra.get_x() + barra.get_width() / 2,
                valor + 0.3, str(valor),
                ha="center", fontweight="bold",
            )
    fig.tight_layout()
    nome_arq = f"grafico_barras_prioridade_{codigo_indicador}.png"
    fig.savefig(nome_arq, dpi=150, bbox_inches="tight")
    plt.close(fig)
    print(f"Grafico salvo: {nome_arq}")
    return nome_arq


# ============================================================
# --- 9. ENGENHARIA DE FEATURES ---
# ============================================================

def criar_features_ml(df_resultado, dados_originais, codigo_indicador):
    """Cria features para treinar o modelo de ML."""
    features = df_resultado.copy()

    le_micro = LabelEncoder()
    features["microarea_cod"] = le_micro.fit_transform(
        features["Microarea"].astype(str)
    )

    features["score_urgencia_temporal"] = 100 - features["Completude (%)"]
    features["dias_min_expirar"] = features["Qtd Faltante"] * 90

    le_nivel = LabelEncoder()
    features["nivel_cod"] = le_nivel.fit_transform(features["Nivel"])

    dummies = pd.get_dummies(features["Nivel"], prefix="nivel")
    features = pd.concat([features, dummies], axis=1)

    colunas_numericas = [
        "Idade", "Prioridade", "microarea_cod",
        "score_urgencia_temporal", "dias_min_expirar",
    ]
    colunas_numericas += [c for c in dummies.columns]

    X = features[colunas_numericas].fillna(0)
    y_class = features["Prioridade"]
    y_reg = features["dias_min_expirar"]
    return X, y_class, y_reg, le_micro, le_nivel, features


# ============================================================
# --- 10. TREINAMENTO DOS MODELOS ---
# ============================================================

def treinar_modelos(X, y_class, y_reg, codigo_indicador):
    """Treina o classificador e o regressor Random Forest."""
    contagem_classes = y_class.value_counts()
    classes_minimas = contagem_classes[contagem_classes < 2]
    usar_stratify = len(classes_minimas) == 0

    if not usar_stratify:
        print(f"\n   AVISO: Classes com apenas 1 amostra detectadas: "
              f"{dict(classes_minimas)}")
        print("   -> Usando split NAO estratificado para este indicador.\n")

    if usar_stratify:
        X_train, X_test, y_train, y_test = train_test_split(
            X, y_class, test_size=0.2, random_state=42, stratify=y_class
        )
    else:
        X_train, X_test, y_train, y_test = train_test_split(
            X, y_class, test_size=0.2, random_state=42
        )

    clf = RandomForestClassifier(
        n_estimators=200, max_depth=10, random_state=42, class_weight="balanced"
    )
    clf.fit(X_train, y_train)
    y_pred = clf.predict(X_test)
    acc = accuracy_score(y_test, y_pred)

    print("\n" + "=" * 50)
    print(f"  CLASSIFICADOR DE PRIORIDADE - {codigo_indicador}")
    print("=" * 50)
    print(f"  Acuracia: {acc:.2%}")
    print(f"  Split: {'estratificado' if usar_stratify else 'nao estratificado'}")
    print("\n  Relatorio de Classificacao:")
    print(classification_report(y_test, y_pred, zero_division=0))

    y_reg_train = y_reg.loc[X_train.index]
    y_reg_test = y_reg.loc[X_test.index]

    reg = RandomForestRegressor(
        n_estimators=200, max_depth=10, random_state=42
    )
    reg.fit(X_train, y_reg_train)
    y_reg_pred = reg.predict(X_test)
    mae = np.mean(np.abs(y_reg_test - y_reg_pred))

    print("\n" + "=" * 50)
    print(f"  REGRESSOR DE DIAS ATE CONSULTA - {codigo_indicador}")
    print("=" * 50)
    print(f"  MAE (Erro Medio Absoluto): {mae:.1f} dias")

    return clf, reg, X_test, y_test, y_pred


# ============================================================
# --- 11. PREVISAO DE DATAS DE CONSULTA ---
# ============================================================

def prever_consultas(clf, reg, X, features, codigo_indicador):
    """Preve datas de consulta para todos os pacientes."""
    prioridade_pred = clf.predict(X)
    dias_pred = reg.predict(X)
    dias_pred = np.maximum(dias_pred, 1).astype(int)

    hoje = datetime.now()
    datas_previstas = [hoje + timedelta(days=int(d)) for d in dias_pred]
    dias_semana = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sab", "Dom"]

    resultado = features.copy()
    resultado["Prioridade_Predita"] = prioridade_pred
    resultado["Data Prevista Consulta"] = [
        d.strftime("%d/%m/%Y") for d in datas_previstas
    ]
    resultado["Dias ate Consulta"] = dias_pred
    resultado["Dia da Semana"] = [dias_semana[d.weekday()] for d in datas_previstas]
    return resultado


# ============================================================
# --- 12. LISTA DE BUSCA ATIVA ---
# ============================================================

def gerar_lista_busca_ativa(df_resultado, codigo_indicador):
    """Gera lista priorizada e exibe na tela com detalhamento completo."""
    busca = df_resultado[df_resultado["Qtd Faltante"] > 0].copy()
    busca = busca.sort_values(["Microarea", "Prioridade"], ascending=[True, False])

    busca_export = busca[[
        "Nome", "Microarea", "Idade", "Nivel", "Completude (%)",
        "Criterios Faltantes", "Qtd Faltante",
        "Detalhamento Faltantes", "Data Avaliacao",
    ]].copy()

    nome_arq = f"lista_busca_ativa_{codigo_indicador}.csv"
    busca_export.to_csv(nome_arq, index=False, encoding="utf-8-sig", sep=";")

    print(f"\nLista de Busca Ativa gerada: {nome_arq}")
    print(f"   Total de pacientes para busca ativa: {len(busca)}")
    print(f"   Pacientes em dia: {len(df_resultado) - len(busca)}")

    print("\n" + "=" * 80)
    print("  DISTRIBUICAO DE PACIENTES POR NIVEL DE PRIORIDADE")
    print(f"  Indicador {codigo_indicador} - {INDICADORES[codigo_indicador]['nome']}")
    print(f"  Data da avaliacao: {datetime.now().strftime('%d/%m/%Y')}")
    print("=" * 80)

    ordem_niveis = ["EM DIA", "MODERADO", "GRAVE", "MUITO GRAVE", "CRITICO"]
    total = len(df_resultado)
    for nivel in ordem_niveis:
        qtd = len(df_resultado[df_resultado["Nivel"] == nivel])
        pct = (qtd / total * 100) if total > 0 else 0
        barra = "#" * int(pct / 2) + "." * (50 - int(pct / 2))
        print(f"  {nivel:<14} {qtd:>4}  ({pct:>5.1f}%)  |{barra}|")
    print("  " + "-" * 78)
    print(f"  {'TOTAL':<17} {total:>4}  (100.0%)")
    print("=" * 80)

    print("\n" + "=" * 80)
    print("  PACIENTES POR NIVEL DE PRIORIDADE - DETALHAMENTO COMPLETO")
    print("=" * 80)
    for nivel in ordem_niveis:
        if nivel == "EM DIA":
            continue
        subset = df_resultado[df_resultado["Nivel"] == nivel]
        if len(subset) == 0:
            continue
        print(f"\n  {nivel} - {len(subset)} paciente(s)")
        print("  " + "-" * 78)
        subset_ordenado = subset.sort_values(
            ["Microarea", "Qtd Faltante"], ascending=[True, False]
        )
        for _, row in subset_ordenado.iterrows():
            nome = str(row["Nome"])[:40]
            microarea = str(row["Microarea"])[:8]
            idade = int(row["Idade"]) if pd.notna(row["Idade"]) else 0
            completude = row["Completude (%)"]
            qtd_falt = int(row["Qtd Faltante"])
            print(f"\n  | Paciente: {nome}")
            print(f"  | Microarea: {microarea}  |  Idade: {idade} anos  "
                  f"|  Completude: {completude:.1f}%  |  Criterios faltantes: {qtd_falt}")
            detalhamento = str(row.get("Detalhamento Faltantes", ""))
            if detalhamento and detalhamento != "Todos os criterios estao adequados":
                print("  |")
                print("  |  CRITERIOS FALTANTES (detalhado):")
                for d in detalhamento.split("\n"):
                    if d.strip():
                        if len(d) > 95:
                            print(f"  |    - {d[:92]}")
                            resto = d[92:]
                            while resto:
                                print(f"  |      {resto[:92]}")
                                resto = resto[92:]
                        else:
                            print(f"  |    - {d}")
    print("\n" + "=" * 80)

    print("\n" + "=" * 80)
    print("  CRITERIOS FALTANTES - VISAO CONSOLIDADA POR CRITERIO")
    print("=" * 80)

    contagem_criterios = Counter()
    detalhes_por_criterio = defaultdict(list)

    for _, row in df_resultado[df_resultado["Qtd Faltante"] > 0].iterrows():
        criterios_str = str(row.get("Criterios Faltantes", ""))
        if criterios_str and criterios_str != "Nenhum":
            for parte in criterios_str.split("; "):
                contagem_criterios[parte] += 1

        detalhamento = str(row.get("Detalhamento Faltantes", ""))
        if detalhamento:
            for linha_det in detalhamento.split("\n"):
                for criterio in contagem_criterios:
                    if linha_det.startswith(criterio):
                        if len(detalhes_por_criterio[criterio]) < 3:
                            detalhes_por_criterio[criterio].append(
                                (row["Nome"], linha_det)
                            )

    if contagem_criterios:
        total_faltantes = len(df_resultado[df_resultado["Qtd Faltante"] > 0])
        print(f"\n  {'Criterio Faltante':<50} {'Pacientes':>10} {'%':>7}")
        print("  " + "-" * 78)
        for criterio, qtd in contagem_criterios.most_common():
            pct = (qtd / total_faltantes * 100) if total_faltantes > 0 else 0
            barra = "#" * int(pct / 5)
            print(f"  {criterio[:50]:<50} {qtd:>5}/{total_faltantes:<4} "
                  f"{pct:>6.1f}% {barra}")
        print("  " + "-" * 78)
        print(f"  Total de pacientes com pelo menos 1 criterio faltante: {total_faltantes}")

        print("\n" + "=" * 80)
        print("  EXEMPLOS DE DETALHAMENTO POR CRITERIO FALTANTE")
        print("  (ate 3 exemplos por criterio)")
        print("=" * 80)

        boas_praticas = definir_boas_praticas(codigo_indicador)
        for criterio, qtd in contagem_criterios.most_common():
            prazo = ""
            for prac in boas_praticas:
                if prac["label"] == criterio:
                    prazo = prac.get("descricao_prazo", "")
                    break
            print(f"\n  {criterio}")
            print(f"     Prazo esperado: {prazo}")
            print(f"     Pacientes afetados: {qtd}")
            print("     " + "-" * 74)
            for nome, detalhe in detalhes_por_criterio.get(criterio, []):
                print(f"     - {str(nome)[:25]:<25} -> {detalhe[len(criterio) + 3:]}")
        print("\n" + "=" * 80)
    else:
        print("\n  Nenhum criterio faltante - todos os pacientes estao em dia!")

    return busca_export


# ============================================================
# --- 13. AGENDA DE CONSULTAS ---
# ============================================================

def gerar_agenda_consultas(df_previsao, codigo_indicador, max_dias=150):
    """Gera agenda de consultas sem descarte silencioso de pacientes."""
    busca = df_previsao[df_previsao["Qtd Faltante"] > 0].copy()
    busca = busca.sort_values("Prioridade", ascending=False)

    hoje = datetime.now()
    data_atual = hoje
    dias_semana = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sab", "Dom"]
    agenda = []
    limite = hoje + timedelta(days=max_dias)
    avisou = False

    for _, paciente in busca.iterrows():
        while data_atual.weekday() >= 5:
            data_atual += timedelta(days=1)

        if data_atual > limite and not avisou:
            print(f"\n   AVISO: Horizonte de {max_dias} dias atingido. "
                  "Os pacientes restantes serao agendados em sequencia.")
            avisou = True

        agenda.append({
            "Data Agendada": data_atual.strftime("%d/%m/%Y"),
            "Dia da Semana": dias_semana[data_atual.weekday()],
            "Microarea": paciente["Microarea"],
            "Paciente": paciente["Nome"],
            "Idade": paciente["Idade"],
            "Nivel Prioridade": paciente["Nivel"],
            "Criterios Faltantes": paciente["Criterios Faltantes"],
            "Qtd Faltante": paciente["Qtd Faltante"],
            "Detalhamento Faltantes": paciente.get("Detalhamento Faltantes", ""),
        })
        data_atual += timedelta(days=1)

    df_agenda = pd.DataFrame(agenda)
    nome_arq = f"agenda_consultas_{codigo_indicador}.csv"
    df_agenda.to_csv(nome_arq, index=False, encoding="utf-8-sig", sep=";")

    print(f"\nAgenda de consultas gerada: {nome_arq}")
    print(f"   Total de agendamentos: {len(df_agenda)}")
    if len(df_agenda) > 0:
        print(f"   Periodo: {df_agenda['Data Agendada'].iloc[0]} a "
              f"{df_agenda['Data Agendada'].iloc[-1]}")

    if len(df_agenda) > 0:
        print("\n" + "=" * 95)
        print("  AGENDA DE CONSULTAS - BUSCA ATIVA INTELIGENTE")
        print(f"  Indicador {codigo_indicador} - {INDICADORES[codigo_indicador]['nome']}")
        print(f"  Data base: {hoje.strftime('%d/%m/%Y')}")
        print("=" * 95)

        datas_unicas = df_agenda["Data Agendada"].unique()
        for data in datas_unicas:
            agenda_dia = df_agenda[df_agenda["Data Agendada"] == data]
            dia_semana = agenda_dia["Dia da Semana"].iloc[0]
            print(f"\n  {data} ({dia_semana})")
            print("  " + "-" * 93)
            for _, row in agenda_dia.iterrows():
                nome = str(row["Paciente"])[:32]
                microarea = str(row["Microarea"])[:8]
                idade = int(row["Idade"]) if pd.notna(row["Idade"]) else 0
                nivel = str(row["Nivel Prioridade"])
                qtd_falt = int(row["Qtd Faltante"])
                print(f"\n  {nome:<32} | MA: {microarea:<8} | Idade: {idade:>3} "
                      f"| {nivel:<12} | Faltam: {qtd_falt}")
                detalhamento = str(row.get("Detalhamento Faltantes", ""))
                if detalhamento and detalhamento != "Todos os criterios estao adequados":
                    for linha_det in detalhamento.split("\n"):
                        if linha_det.strip():
                            if len(linha_det) > 88:
                                print(f"       -> {linha_det[:85]}")
                                resto = linha_det[85:]
                                while resto:
                                    print(f"          {resto[:85]}")
                                    resto = resto[85:]
                            else:
                                print(f"       -> {linha_det}")
            print("\n  " + "-" * 93)
            print(f"  Total do dia: {len(agenda_dia)} consulta(s)")

        print("\n" + "=" * 95)
        print("  RESUMO DA AGENDA")
        print("=" * 95)
        print("\n  Consultas por dia da semana:")
        for dia in ["Seg", "Ter", "Qua", "Qui", "Sex"]:
            qtd = len(df_agenda[df_agenda["Dia da Semana"] == dia])
            if qtd > 0:
                print(f"     {dia}: {qtd:>3}  {'#' * qtd}")

        print("\n  Consultas por nivel de prioridade:")
        for nivel in ["MODERADO", "GRAVE", "MUITO GRAVE", "CRITICO"]:
            qtd = len(df_agenda[df_agenda["Nivel Prioridade"] == nivel])
            if qtd > 0:
                pct = (qtd / len(df_agenda) * 100)
                print(f"     {nivel:<12}: {qtd:>3}  ({pct:.1f}%)")

        print("\n  Consultas por microarea:")
        for ma, qtd in df_agenda["Microarea"].value_counts().sort_index().items():
            print(f"     MA {ma}: {qtd:>3}  {'#' * qtd}")

        print("\n  " + "-" * 93)
        print(f"  TOTAL: {len(df_agenda)} consultas agendadas em "
              f"{len(datas_unicas)} dia(s) uteis")
        print("=" * 95)
    else:
        print("\n  Nenhum paciente precisa de agendamento - todos estao em dia!")

    return df_agenda


# ============================================================
# --- 14. RELATORIO DE COMPLETUDE ---
# ============================================================

def relatorio_completude(df_resultado, codigo_indicador):
    """Gera relatorio de completude por microarea."""
    rel = df_resultado.groupby("Microarea").agg({
        "Nome": "count",
        "Completude (%)": "mean",
        "Qtd Faltante": "mean",
        "Prioridade": "mean",
    }).round(2)

    rel.columns = [
        "Total de Pacientes", "Completude Media (%)",
        "Media de Criterios Faltantes", "Prioridade Media",
    ]
    rel = rel.sort_values("Prioridade Media", ascending=False)

    nome_arq = f"relatorio_completude_{codigo_indicador}.csv"
    rel.to_csv(nome_arq, encoding="utf-8-sig", sep=";")

    print("\nRelatorio de completude por microarea:")
    print(f"   Arquivo: {nome_arq}")
    print(rel.to_string())
    return rel


# ============================================================
# --- 15. SALVAMENTO DO MODELO ---
# ============================================================

def salvar_modelo(clf, reg, le_micro, le_nivel, codigo_indicador,
                  colunas_features, boas_praticas):
    """Salva o modelo treinado em arquivo .pkl para reuso."""
    modelo_bundle = {
        "codigo_indicador": codigo_indicador,
        "nome_indicador": INDICADORES[codigo_indicador]["nome"],
        "classificador": clf,
        "regressor": reg,
        "label_encoder_microarea": le_micro,
        "label_encoder_nivel": le_nivel,
        "colunas_features": colunas_features,
        "boas_praticas": boas_praticas,
        "config_indicador": INDICADORES[codigo_indicador],
        "data_treinamento": datetime.now().strftime("%d/%m/%Y %H:%M:%S"),
        "versao": "1.0",
    }

    nome_arq = f"modelo_busca_ativa_{codigo_indicador}.pkl"
    joblib.dump(modelo_bundle, nome_arq)

    print("\n" + "=" * 60)
    print("  MODELO SALVO COM SUCESSO")
    print("=" * 60)
    print(f"  Arquivo: {nome_arq}")
    print(f"  Indicador: {codigo_indicador} - {INDICADORES[codigo_indicador]['nome']}")
    print(f"  Data: {modelo_bundle['data_treinamento']}")
    print(f"  Versao: {modelo_bundle['versao']}")
    print(f"  Features: {len(colunas_features)} colunas")
    print(f"  Boas Praticas: {len(boas_praticas)} criterios")
    print("=" * 60)
    return nome_arq


# ============================================================
# --- 16. CARREGAR E USAR MODELO SALVO ---
# ============================================================

def carregar_e_usar_modelo(caminho_modelo, caminho_csv):
    """Carrega um modelo salvo e aplica em um novo CSV."""
    modelo = joblib.load(caminho_modelo)
    print(f"\nModelo carregado: {caminho_modelo}")
    print(f"   Indicador original: {modelo['codigo_indicador']}")

    df, _ = carregar_csv(caminho_csv)
    codigo_novo = detectar_indicador(df.columns)

    if codigo_novo != modelo["codigo_indicador"]:
        print(f"\nAVISO: O CSV corresponde ao indicador {codigo_novo}, "
              f"mas o modelo foi treinado para {modelo['codigo_indicador']}.")
        print("   Recomenda-se treinar um novo modelo para este indicador.")
        return None

    dados, _ = preparar_dados(df, codigo_novo)
    df_resultado = verificar_criterios(dados, codigo_novo)
    X, _, _, _, _, features = criar_features_ml(df_resultado, dados, codigo_novo)

    for coluna in modelo["colunas_features"]:
        if coluna not in X.columns:
            X[coluna] = 0
    X = X[modelo["colunas_features"]]

    return prever_consultas(
        modelo["classificador"], modelo["regressor"], X, features, codigo_novo
    )


# ============================================================
# --- FLUXO PRINCIPAL ---
# ============================================================

def main(caminho_csv=None):
    print("=" * 60)
    print("  BUSCA ATIVA INTELIGENTE - CODIGO INTEGRADO MULTINDICADOR")
    print("  Deteccao automatica: C2, C3, C4, C5, C6, C7")
    print("=" * 60)

    print("\n[1/10] Carregando arquivo CSV...")
    df, nome_arquivo = carregar_csv(caminho_csv)

    print("\n[2/10] Detectando indicador...")
    codigo_indicador = detectar_indicador(df.columns)
    config = INDICADORES[codigo_indicador]

    print(f"\n[3/10] Preparando dados para {codigo_indicador} - {config['nome']}...")
    dados, mapeamento = preparar_dados(df, codigo_indicador)
    print(f"   Dados preparados: {len(dados)} pacientes")
    print(f"   Colunas mapeadas: {len(mapeamento)}")

    print(f"\n[4/10] Verificando {config['num_boas_praticas']} boas praticas...")
    df_resultado = verificar_criterios(dados, codigo_indicador)
    print(f"   Classificacao concluida para {len(df_resultado)} pacientes")

    print("\n[5/10] Gerando graficos exploratorios...")
    gerar_grafico_pizza(df_resultado, codigo_indicador)
    gerar_grafico_barras(df_resultado, codigo_indicador)

    print("\n[6/10] Criando features para Machine Learning...")
    X, y_class, y_reg, le_micro, le_nivel, features = criar_features_ml(
        df_resultado, dados, codigo_indicador
    )
    print(f"   Features criadas: {X.shape[1]} colunas")
    print(f"   Amostras: {X.shape[0]}")

    print("\n[7/10] Treinando modelos de ML (Random Forest)...")
    clf, reg, X_test, y_test, y_pred = treinar_modelos(
        X, y_class, y_reg, codigo_indicador
    )
    df_previsao = prever_consultas(clf, reg, X, features, codigo_indicador)

    print("\n[8/10] Gerando lista de busca ativa...")
    busca = gerar_lista_busca_ativa(df_previsao, codigo_indicador)

    print("\n[9/10] Gerando agenda de consultas...")
    agenda = gerar_agenda_consultas(df_previsao, codigo_indicador)

    print("\n[9b/10] Gerando relatorio de completude...")
    relatorio_completude(df_resultado, codigo_indicador)

    print("\n[10/10] Salvando modelo treinavel...")
    boas_praticas = definir_boas_praticas(codigo_indicador)
    nome_modelo = salvar_modelo(
        clf, reg, le_micro, le_nivel, codigo_indicador,
        list(X.columns), boas_praticas,
    )

    print("\n" + "=" * 60)
    print("  PIPELINE CONCLUIDO COM SUCESSO!")
    print("=" * 60)
    print(f"  Indicador: {codigo_indicador} - {config['nome']}")
    print(f"  Pacientes analisados: {len(df_resultado)}")
    print(f"  Pacientes para busca ativa: {len(busca)}")
    print(f"  Modelo salvo: {nome_modelo}")
    print("=" * 60)

    return df_resultado, df_previsao, busca, agenda, nome_modelo


if __name__ == "__main__":
    main()
