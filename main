             "tipo": "data", "max_dias": 365,
             "idade_min": 14, "idade_max": 69,
             "descricao_prazo": "12 meses - 14-69 anos"},
            {"label": "Rastreamento de cancer de mama (mamografia)",
             "chave": "data_mamo", "tipo": "data", "max_dias": 730,
             "idade_min": 50, "idade_max": 69,
             "descricao_prazo": "2 anos - mulheres 50-69 anos"},
        ]
    return []


def parse_doses_vacina(valor_coluna):
    """Faz o parse da coluna de vacina do CSV."""
    if pd.isna(valor_coluna) or str(valor_coluna).strip() in ("", "nan", "None"):
        return {}
    texto = str(valor_coluna).strip()
    doses_encontradas = {}
    padrao_dose = re.compile(r"D(\d+)\s*[-\u2013]\s*", re.IGNORECASE)
    matches = list(padrao_dose.finditer(texto))
    for i, match in enumerate(matches):
        dose_num = int(match.group(1))
        inicio = match.end()
        fim = matches[i + 1].start() if i + 1 < len(matches) else len(texto)
        descricao = texto[inicio:fim].strip().rstrip(",").strip()
        doses_encontradas[dose_num] = descricao
    return doses_encontradas


# ============================================================
# --- 7. VERIFICACAO DE CRITERIOS ---
# ============================================================

def _verificar_criterio_detalhado(linha, pratica, colunas, codigo_indicador):
    """Verifica se um criterio foi atendido para um paciente."""
    chave = pratica["chave"]
    tipo = pratica["tipo"]
    label = pratica["label"]
    hoje = datetime.now()

    idade_min = pratica.get("idade_min")
    idade_max = pratica.get("idade_max")
    if idade_min is not None or idade_max is not None:
        try:
            idade = float(linha.get("Idade", 0) or 0)
        except (TypeError, ValueError):
            idade = 0.0
        if idade > 0:
            if idade_min is not None and idade_max is not None:
                faixa = f"{idade_min}-{idade_max} anos"
            elif idade_min is not None:
                faixa = f"{idade_min}+ anos"
            else:
                faixa = f"ate {idade_max} anos"
            if idade_min is not None and idade < idade_min:
                return False, (
                    f"{label} - Nao se aplica (paciente tem {idade:.0f} anos, "
                    f"faixa: {faixa})"
                ), True
            if idade_max is not None and idade > idade_max:
                return False, (
                    f"{label} - Nao se aplica (paciente tem {idade:.0f} anos, "
                    f"faixa: {faixa})"
                ), True

    prazo = pratica.get("descricao_prazo", "")

    if tipo == "quantidade":
        if chave not in colunas:
            return True, f"{label} - dados nao encontrados no CSV", False
        valor = pd.to_numeric(linha[chave], errors="coerce")
        minimo = pratica["minimo"]
        if pd.isna(valor) or valor == 0:
            return True, (
                f"{label} - NENHUMA realizacao registrada "
                f"(0 de {minimo} esperado). Prazo: {prazo}"
            ), False
        if valor < minimo:
            return True, (
                f"{label} - Realizadas: {int(valor)} de {minimo} esperado. "
                f"Prazo: {prazo}"
            ), False
        return False, (
            f"{label} - Adequado. Realizadas: {int(valor)} de {minimo} "
            f"esperado. Prazo: {prazo}"
        ), False

    if tipo == "data_e_quantidade":
        qtd_chave = pratica.get("chave_qtd", chave)
        max_dias = pratica["max_dias"]
        minimo = pratica["minimo"]
        problemas = []
        data_ok_str = ""
        qtd_ok_str = ""

        if chave not in colunas:
            problemas.append("coluna de data nao encontrada no CSV")
        else:
            valor_data = linha[chave]
            if not _valor_valido(valor_data):
                problemas.append("NENHUMA data de medicao registrada")
            else:
                data = _parse_data(valor_data)
                if data is not None and not pd.isna(data):
                    dias = (hoje - data).days
                    if dias > max_dias:
                        problemas.append(
                            f"ultima medicao: {data.strftime('%d/%m/%Y')} "
                            f"({dias} dias atras, limite: {max_dias} dias)"
                        )
                    else:
                        data_ok_str = (
                            f"{data.strftime('%d/%m/%Y')} ({dias} dias atras)"
                        )
                else:
                    dias_val = _para_numero(valor_data)
                    if dias_val is None:
                        problemas.append(f"data invalida: '{valor_data}'")
                    elif dias_val > max_dias:
                        problemas.append(
                            f"ultima medicao ha {int(dias_val)} dias "
                            f"(limite: {max_dias} dias)"
                        )
                    else:
                        data_ok_str = f"{int(dias_val)} dias atras"

        if qtd_chave not in colunas:
            problemas.append("coluna de quantidade nao encontrada no CSV")
        else:
            valor_qtd = pd.to_numeric(linha[qtd_chave], errors="coerce")
            if pd.isna(valor_qtd) or valor_qtd == 0:
                problemas.append(f"NENHUMA medicao registrada (minimo: {minimo})")
            elif valor_qtd < minimo:
                problemas.append(
                    f"apenas {int(valor_qtd)} medicao(oes) (minimo: {minimo})"
                )
            else:
                qtd_ok_str = f"{int(valor_qtd)} medicao(oes)"

        if problemas:
            return True, f"{label} - " + "; ".join(problemas) + f". Prazo: {prazo}", False
        return False, f"{label} - Adequado. Ultima: {data_ok_str}, {qtd_ok_str}", False

    if tipo == "data":
        if chave not in colunas:
            return True, f"{label} - coluna de data nao encontrada no CSV", False
        valor = linha[chave]
        if not _valor_valido(valor):
            return True, f"{label} - NENHUMA data registrada. Prazo: {prazo}", False

        max_dias = pratica["max_dias"]
        data = _parse_data(valor)
        if data is not None and not pd.isna(data):
            dias = (hoje - data).days
            if dias > max_dias:
                return True, (
                    f"{label} - Ultima data: {data.strftime('%d/%m/%Y')} "
                    f"({dias} dias atras). Limite: {max_dias} dias. Prazo: {prazo}"
                ), False
            return False, (
                f"{label} - Adequado. Ultima data: "
                f"{data.strftime('%d/%m/%Y')} ({dias} dias atras)"
            ), False

        dias_valor = _para_numero(valor)
        if dias_valor is None:
            return True, (
                f"{label} - Data invalida ou ilegivel: '{valor}'. Prazo: {prazo}"
            ), False
        if dias_valor > max_dias:
            return True, (
                f"{label} - Ultimo registro ha {int(dias_valor)} dias. "
                f"Limite: {max_dias} dias. Prazo: {prazo}"
            ), False
        return False, f"{label} - Adequado ({int(dias_valor)} dias atras)", False

    if tipo == "data_ou_meses":
        if chave not in colunas:
            return True, f"{label} - coluna nao encontrada no CSV", False

        chave_lower = chave.lower()
        col_dias = col_meses = None
        if "meses" in chave_lower:
            col_meses = chave
            candidata = chave_lower.replace("meses", "dias")
            col_dias = candidata if candidata in colunas else None
        elif "dias" in chave_lower:
            col_dias = chave
            candidata = chave_lower.replace("dias", "meses")
            col_meses = candidata if candidata in colunas else None
        else:
            col_meses = chave

        valor = linha[chave]
        if not _valor_valido(valor):
            return True, f"{label} - NENHUM registro encontrado. Prazo: {prazo}", False

        max_dias = pratica["max_dias"]
        data = _parse_data(valor)
        if data is not None and not pd.isna(data):
            dias = (hoje - data).days
            if dias > max_dias:
                return True, (
                    f"{label} - Ultima data: {data.strftime('%d/%m/%Y')} "
                    f"({dias} dias atras). Limite: {max_dias} dias. Prazo: {prazo}"
                ), False
            return False, (
                f"{label} - Adequado. Ultima data: "
                f"{data.strftime('%d/%m/%Y')} ({dias} dias atras)"
            ), False

        dias, origem = _obter_dias_de_colunas(linha, col_dias, col_meses)
        if dias is None:
            return False, (
                "Nao foi possivel determinar o periodo do criterio: "
                "coluna de dias ou meses nao encontrada."
            ), False

        if dias > max_dias:
            if origem == "meses":
                return True, (
                    f"{label} - Ultimo registro ha {dias / 30:.1f} meses "
                    f"({dias} dias). Limite: {max_dias} dias. Prazo: {prazo}"
                ), False
            return True, (
                f"{label} - Ultimo registro ha {dias} dias. "
                f"Limite: {max_dias} dias. Prazo: {prazo}"
            ), False

        if origem == "meses":
            return False, (
                f"{label} - Adequado ({dias / 30:.1f} meses / {dias} dias atras)"
            ), False
        return False, f"{label} - Adequado ({dias} dias atras)", False

    if tipo == "vacinas_multiplas":
        faltantes = []
        ok = []
        valores_sim = {"SIM", "1", "TRUE", "V", "COMPLETA", "EM_DIA", "EM DIA", "APLICADA"}
        padrao_data = re.compile(r"\d{2}/\d{2}/\d{2,4}")
        padrao_dose = re.compile(r"\b(D\d?|R\d|REF|DU)\b")

        for vacina in pratica["vacinas"]:
            if vacina not in colunas:
                faltantes.append(vacina)
                continue
            valor = str(linha[vacina]).strip()
            if not valor or valor.lower() in {"nan", "none"}:
                faltantes.append(vacina)
                continue

            valor_upper = valor.upper()
            if valor_upper in valores_sim:
                ok.append(vacina)
                continue

            if padrao_data.search(valor) or padrao_dose.search(valor_upper):
                datas = padrao_data.findall(valor)
                ok.append(
                    f"{vacina} (aplicada em {datas[-1]})" if datas
                    else f"{vacina} (registrada)"
                )
            else:
                faltantes.append(vacina)

        if faltantes:
            return True, (
                f"{label} - Vacinas faltantes: {', '.join(faltantes)}. "
                f"Concluidas: {', '.join(ok) if ok else 'nenhuma'}. Prazo: {prazo}"
            ), False
        return False, f"{label} - Adequado (todas as vacinas aplicadas)", False

    if tipo == "texto_vacina":
        valor = str(linha.get(chave, "")).strip()
        if not valor or valor.lower() == "nan":
            for nome_coluna, conteudo in linha.items():
                if "influenza" in str(nome_coluna).lower():
                    valor = str(conteudo).strip()
                    break
        if not valor or valor.lower() == "nan" or valor == "-":
            return True, f"{label}: vacina nao registrada", False
        return False, "", False

    if tipo == "exames_multiplos":
        faltantes = []
        ok = []
        for exame in pratica["exames"]:
            if exame not in colunas:
                faltantes.append(exame)
                continue
            valor = str(linha[exame]).strip().upper()
            if valor in {"SIM", "1", "TRUE", "POSITIVO"}:
                ok.append(exame)
            elif valor in {"NAO_SE_APLICA", "N/A", "NAO APLICA", "NAO SE APLICA"}:
                ok.append(f"{exame} (nao se aplica)")
            else:
                faltantes.append(exame)

        if faltantes:
            return True, (
                f"{label} - Exames faltantes: {', '.join(faltantes)}. "
                f"Realizados: {', '.join(ok) if ok else 'nenhum'}. Prazo: {prazo}"
            ), False
        return False, f"{label} - Adequado (todos os exames realizados)", False

    return True, f"{label} - Tipo de criterio nao reconhecido", False


def verificar_criterios(dados, codigo_indicador):
    """Avalia cada paciente e calcula completude e nivel de prioridade."""
    boas_praticas = definir_boas_praticas(codigo_indicador)
    config = INDICADORES[codigo_indicador]
    niveis = config["niveis_prioridade"]
    max_prioridade = config["max_prioridade"]
    colunas = set(dados.columns)
    hoje_str = datetime.now().strftime("%d/%m/%Y")

    resultados = []
    for _, linha in dados.iterrows():
        faltou = 0
        detalhes = []
        labels = []
        aplicaveis = 0

        for pratica in boas_praticas:
            faltou_crit, detalhe, nao_aplica = _verificar_criterio_detalhado(
                linha, pratica, colunas, codigo_indicador
            )
            if nao_aplica:
                continue
            aplicaveis += 1
            if faltou_crit:
                faltou += 1
                detalhes.append(detalhe)
                labels.append(pratica["label"])

        completude = 100.0 if aplicaveis == 0 else (
            (aplicaveis - faltou) / aplicaveis
        ) * 100

        nivel = (
            niveis.get(max_prioridade, "CRITICO")
            if faltou >= max_prioridade
            else niveis.get(faltou, "EM DIA")
        )

        resultados.append({
            "Nome": linha["Nome"],
            "Microarea": linha["Microarea"],
            "Idade": linha.get("Idade", 0),
            "Prioridade": faltou,
            "Nivel": nivel,
            "Completude (%)": completude,
            "Qtd Faltante": faltou,
            "Criterios Faltantes": "; ".join(labels) if labels else "Nenhum",
            "Detalhamento Faltantes": (
                "\n".join(detalhes) if detalhes
                else "Todos os criterios estao adequados"
            ),
            "Data Avaliacao": hoje_str,
        })

    return pd.DataFrame(resultados)


