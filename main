@lru_cache(maxsize=8192)
def _normalizar_texto(texto: Any) -> str:
    """Normaliza texto: minusculas, sem acentos, sem pontuacao."""
    if not isinstance(texto, str):
        return ""
    decomposto = unicodedata.normalize("NFKD", texto.lower())
    sem_acento = "".join(c for c in decomposto if not unicodedata.combining(c))
    limpo = re.sub(r"[^a-z0-9\s]", "", sem_acento)
    return " ".join(limpo.split())


_FORMATOS_DATA = (
    "%d/%m/%Y", "%d/%m/%y",
    "%Y-%m-%d",
    "%d-%m-%Y", "%d-%m-%y",
    "%Y/%m/%d",
    "%m/%d/%Y", "%m/%d/%y",
)


@lru_cache(maxsize=65536)
def _parse_data(data_str: Any) -> Any:
    """Converte string para datetime, suportando multiplos formatos."""
    if data_str is None or (isinstance(data_str, float) and pd.isna(data_str)):
        return pd.NaT
    texto = str(data_str).strip()
    if not texto:
        return pd.NaT
    for fmt in _FORMATOS_DATA:
        try:
            return datetime.strptime(texto, fmt)
        except ValueError:
            continue
    return pd.NaT


def _para_numero(valor: Any) -> float | None:
    """Converte '365', '12 meses', '365,0' em numero. None se invalido."""
    if valor is None:
        return None
    try:
        if pd.isna(valor):
            return None
    except (TypeError, ValueError):
        pass
    if isinstance(valor, str):
        texto = valor.strip().replace(",", ".")
        for palavra in ("dias", "dia", "meses", "mes", "mês"):
            texto = texto.replace(palavra, "")
        texto = texto.strip()
        if not texto:
            return None
    else:
        texto = valor
    try:
        numero = float(texto)
    except (TypeError, ValueError):
        return None
    return int(numero) if numero.is_integer() else numero


def _extrair_meses(val: Any) -> int:
    numero = _para_numero(val)
    return int(numero) if numero is not None else 0


def _parse_idade(val: Any) -> int:
    numero = _para_numero(val)
    if numero is None:
        return 0
    idade = int(numero)
    return idade if 0 < idade < 130 else 0


def _valor_valido(valor: Any) -> bool:
    if valor is None:
        return False
    try:
        if pd.isna(valor):
            return False
    except (TypeError, ValueError):
        pass
    return not (isinstance(valor, str) and not valor.strip())


def _obter_dias_de_colunas(linha, col_dias=None, col_meses=None):
    """Obtem a quantidade de dias de um criterio."""
    indice_normalizado = {_normalizar_texto(str(c)): c for c in linha.index}

    def valor_da_config(candidato):
        if not _valor_valido(candidato):
            return None
        if isinstance(candidato, (list, tuple, set)):
            for item in candidato:
                valor = valor_da_config(item)
                if _valor_valido(valor):
                    return valor
            return None
        if isinstance(candidato, (int, float)) and not isinstance(candidato, bool):
            return candidato
        nome = str(candidato).strip()
        if not nome:
            return None
        if nome in linha.index:
            return linha[nome]
        coluna_real = indice_normalizado.get(_normalizar_texto(nome))
        return linha[coluna_real] if coluna_real is not None else None

    def candidatos(valor):
        if not _valor_valido(valor):
            return []
        if isinstance(valor, (list, tuple, set)):
            return list(valor)
        return [valor]

    for candidato in candidatos(col_dias):
        numero = _para_numero(valor_da_config(candidato))
        if numero is not None:
            return numero, "dias"

    for candidato in candidatos(col_meses):
        numero = _para_numero(valor_da_config(candidato))
        if numero is not None:
            return numero * 30, "meses"

    for valor, origem, fator in ((col_dias, "dias", 1), (col_meses, "meses", 30)):
        if isinstance(valor, (int, float)) and not isinstance(valor, bool):
            return valor * fator, origem

    return None, None


